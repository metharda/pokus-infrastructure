{
  "_generated_from": "preflight/requirements.yml, versions.lock.yml, images/*/image.yaml and the Ansible defaults by tools/gen (make generate); do not edit",
  "schema_version": 1,
  "image_unpack_factor": 2.5,
  "components": [
    {
      "id": "base",
      "title": "host services",
      "kind": "fixed",
      "roles": [
        "full",
        "lab",
        "inference"
      ],
      "memory_gib": {
        "required": 1.0,
        "recommended": 1.5
      },
      "cpu_threads": 0.5,
      "basis": "estimated",
      "source": "estimate: resident memory of sshd, tailscaled, dockerd and containerd and pinka's units and timers on a small host; the upper value leaves room for the page cache they use"
    },
    {
      "id": "incus",
      "title": "Incus daemon",
      "kind": "fixed",
      "roles": [
        "full",
        "lab"
      ],
      "memory_gib": {
        "required": 0.2,
        "recommended": 0.4
      },
      "cpu_threads": 0.2,
      "basis": "estimated",
      "source": "estimate: incusd and lxcfs idle, without instances"
    },
    {
      "id": "postgres",
      "title": "PostgreSQL",
      "kind": "fixed",
      "roles": [
        "full",
        "lab"
      ],
      "memory_gib": {
        "required": 0.5,
        "recommended": 1.5
      },
      "cpu_threads": 0.5,
      "basis": "estimated",
      "source": "pinka's shared_buffers (1/16 of the memory, 128 MiB to 4 GiB) plus about 10 MiB per connection; the upper value is a 16-32 GiB host's shared_buffers with a platform's connections"
    },
    {
      "id": "stores",
      "title": "telemetry stores",
      "kind": "fixed",
      "roles": [
        "full",
        "lab"
      ],
      "memory_gib": {
        "required": 1.5,
        "recommended": 3.0
      },
      "cpu_threads": 0.5,
      "basis": "estimated",
      "source": "estimate: Prometheus, Loki, Tempo, Grafana and the query proxy; Prometheus at about 5,000 series (the lab's exporters at 15 s), Loki and Tempo as single binaries, Grafana; grows with the platform's own metrics, logs and traces"
    },
    {
      "id": "collectors",
      "title": "collectors and exporters",
      "kind": "fixed",
      "roles": [
        "full",
        "lab",
        "inference"
      ],
      "memory_gib": {
        "required": 0.3,
        "recommended": 0.8
      },
      "cpu_threads": 0.3,
      "basis": "estimated",
      "source": "the OpenTelemetry collectors, node_exporter, cAdvisor and the database and GPU exporters: the gateway collector's memory_limiter (observability_collector_memory_mib, 512 MiB) and half of it for the journald collector as the upper value; the exporters about 50 MiB each"
    },
    {
      "id": "opa",
      "title": "OPA",
      "kind": "fixed",
      "roles": [
        "full",
        "lab"
      ],
      "memory_gib": {
        "required": 0.1,
        "recommended": 0.2
      },
      "cpu_threads": 0.1,
      "basis": "estimated",
      "source": "estimate: OPA with the platform's policy bundle"
    },
    {
      "id": "install",
      "title": "bootstrap and the installer",
      "kind": "fixed",
      "roles": [
        "full",
        "lab",
        "inference"
      ],
      "memory_gib": {
        "required": 0.5,
        "recommended": 0.8
      },
      "cpu_threads": 1,
      "basis": "estimated",
      "source": "estimate: ansible-playbook at its peak (0.3-0.6 GiB) and the installer TUI (0.1-0.2 GiB); they run again on every update next to the running lab"
    },
    {
      "id": "targets",
      "title": "concurrent targets",
      "kind": "targets",
      "roles": [
        "full",
        "lab"
      ],
      "cpu_threads": 1,
      "basis": "estimated",
      "source": "the profiles' limits of the incus role (incus_target_container, incus_target_vm, incus_build_instance) times the concurrent targets"
    },
    {
      "id": "vllm",
      "title": "vLLM serving the selected model",
      "kind": "vllm",
      "roles": [
        "full",
        "inference"
      ],
      "overhead_gib": {
        "required": 3.0,
        "recommended": 5.0
      },
      "cpu_threads": 2,
      "basis": "estimated",
      "source": "estimate: Python, PyTorch and the CUDA libraries (about 3 GiB) plus the model's file size from models.lock.yml while it loads"
    },
    {
      "id": "training",
      "title": "a training job",
      "kind": "training",
      "roles": [
        "full"
      ],
      "cpu_threads": 0,
      "basis": "estimated",
      "source": "training_caps.memory_max (§7.18); the arbiter refuses a job over it"
    }
  ],
  "training_cap": {
    "floor_gib": 4,
    "ceiling_gib": 24,
    "source": "floor: the least a job needs besides its model, a data loader and a small batch in host memory (estimate); ceiling: the fixed default before the cap was computed (§8.1, 24G)"
  },
  "disk": {
    "pinka_gib": 5,
    "pinka_basis": "estimated",
    "pinka_source": "estimate from the environments the locks install (about 2-3 GiB) with room for an update, which installs next to the running version",
    "incus_dir": "/var/lib/incus",
    "pool_file": "/var/lib/incus/disks/pinka-targets.img"
  },

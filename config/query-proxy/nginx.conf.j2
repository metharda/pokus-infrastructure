# Managed by pinka (config/query-proxy/nginx.conf.j2). Local changes will be overwritten.
#
# The telemetry query proxy, the only way to query
# telemetry. It forwards to Prometheus, Loki and Tempo only their query
# endpoints, an allowlist of methods and paths verified against the pinned
# releases (Prometheus v3.15.0 web/api/v1/api.go, Loki 3.7.8
# pkg/util/constants/api_paths.go and pkg/loki/modules.go, Tempo 2.10.8
# pkg/api/http.go): instant and range queries, series, labels and label
# values, trace lookup and search. Everything else, above all push and remote
# write, deletion, admin, configuration, flush, rules and alerting, is
# answered with 403. It adds no credentials and does not change queries: only
# its path prefix (/prometheus, /loki, /tempo) is removed. Listeners: the
# socket that /run/pinka/query.sock links to (group pinka-query) and a
# loopback port for Grafana, which the telemetry guard closes to platform
# accounts.
worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;

events {
    worker_connections 256;
}

http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;

    server {
        listen unix:/run/query/query.sock;
        listen 127.0.0.1:{{ pinka_internal_ports.query_proxy }};

        # Prometheus: instant and range queries, series, labels, label values.
        location ~ ^/prometheus(/api/v1/(query|query_range|series|labels|label/[^/]+/values))$ {
            limit_except GET POST { deny all; }
            rewrite ^/prometheus(/.*)$ $1 break;
            proxy_pass http://127.0.0.1:{{ pinka_ports.prometheus }};
        }

        # Loki: the same, below /loki/api/v1.
        location ~ ^/loki(/loki/api/v1/(query|query_range|series|labels|label/[^/]+/values))$ {
            limit_except GET POST { deny all; }
            rewrite ^/loki(/.*)$ $1 break;
            proxy_pass http://127.0.0.1:{{ pinka_ports.loki }};
        }

        # Tempo: trace lookup (v1 and v2) and search with its tags and tag values.
        location ~ ^/tempo(/api/(traces/[^/]+|v2/traces/[^/]+|search|search/tags|search/tag/[^/]+/values|v2/search/tags|v2/search/tag/[^/]+/values))$ {
            limit_except GET { deny all; }
            rewrite ^/tempo(/.*)$ $1 break;
            proxy_pass http://127.0.0.1:{{ pinka_ports.tempo }};
        }

        location / {
            return 403;
        }
    }
}

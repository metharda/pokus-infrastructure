# Managed by pinka (ansible/roles/lab_session/templates/pinka-session-start.service.j2). Local changes will be overwritten.
#
# Session record of this boot (BUILD_PROMPT §7.16, contracts.md):
# {{ lab_session_sessions_dir }}/<boot_id>.json, written once per boot.
[Unit]
Description=Pokus lab session record
After=pinka-health-gate.service
PartOf=pinka-lab.target

[Service]
Slice={{ pinka_services_slice }}
Type=oneshot
RemainAfterExit=yes
ExecStart={{ lab_session_libexec }}/session-start --sessions {{ lab_session_sessions_dir }}
TimeoutStartSec=900
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=pinka-lab.target

# Managed by pinka (ansible/roles/lab_session/templates/pinka-window-expiry.service.j2). Local changes will be overwritten.
#
# Staging on shared hardware (BUILD_PROMPT §7.20): stops the staging lab once
# its maintenance window has ended, exactly like pinka stop (drain hook first).
[Unit]
Description=Stop the staging lab when its maintenance window ends

[Service]
Type=oneshot
Slice={{ pinka_services_slice }}
ExecStart=/usr/local/bin/pinka window expire
TimeoutStartSec=3600

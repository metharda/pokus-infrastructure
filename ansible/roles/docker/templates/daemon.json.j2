{#- Managed by pinka (ansible/roles/docker/templates/daemon.json.j2). Local changes will be overwritten.
    JSON has no comments and dockerd rejects unknown keys, so the managed
    header is written as an engine label (preflight looks for it). Written
    only for a Docker Engine pinka installed (BUILD_PROMPT §7.6): the log
    driver, cgroup parent and networks live in pinka's Compose projects. -#}
{%- set base = {
  "labels": ["org.pinka.managed=Managed by pinka (ansible/roles/docker/templates/daemon.json.j2). Local changes will be overwritten."],
  "data-root": docker_data_root,
  "live-restore": true,
} -%}
{%- set gpu = {
  "cdi": {"features": {"cdi": true}},
  "runtime": {"runtimes": {"nvidia": {"path": "/usr/bin/nvidia-container-runtime", "args": []}}},
}[docker_gpu_setting] | default({}) -%}
{%- set selinux = {"selinux-enabled": true} if pinka_mac == 'selinux' else {} -%}
{{ base | combine(gpu, selinux) | to_nice_json(indent=2) }}

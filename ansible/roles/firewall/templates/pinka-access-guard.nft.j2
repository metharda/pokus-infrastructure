#!/usr/sbin/nft -f
# Managed by pinka (ansible/roles/firewall/templates/pinka-access-guard.nft.j2). Local changes will be overwritten.
#
# The access guard (BUILD_PROMPT §7.5, approved deviation AG1), the same on
# every firewall backend: what was reachable before pinka and the owner
# consented to close, and the install's access path once the safeguard held,
# are dropped here. The owner's own tables, zones and rules stay as they are,
# and this table refers to none of them, so removing it makes everything
# reachable again as it was. Every drop rule matches only a new connection
# (connections already open stay open, the install's own session included)
# and never one on loopback. SSH over the tailnet is never cut: tcp/22 on
# {{ firewall_tailnet_interface }} is accepted first, and only that port; what the owner closed
# is closed over the tailnet as well. A drop in any base chain is final; the
# accepts below only end this chain, the other tables still decide.
table inet pinka_access_guard
delete table inet pinka_access_guard

table inet pinka_access_guard {
{% set guard_path = firewall_install_path if firewall_install_path is not none and firewall_install_path.closed else none %}
{% if firewall_listener_rules.closed | length > 0 or guard_path is not none %}
	chain input {
		type filter hook input priority filter - 5; policy accept;
		# SSH over the tailnet is never cut.
		iifname "{{ firewall_tailnet_interface }}" tcp dport 22 accept
{% if ssh_extra_allowed_interfaces | length > 0 %}
		# SSH on the extra interfaces stays as pinka's policy has it.
		iifname { {{ ssh_extra_allowed_interfaces | map('regex_replace', '^(.*)$', '"\\1"') | join(', ') }} } tcp dport 22 accept
{% endif %}
{% for rule in firewall_listener_rules.closed %}
		# {{ rule.name }}: closed with the owner's consent (firewall_close_listeners).
		iifname != "lo" ct state new {{ (rule.family ~ ' daddr ' ~ rule.address ~ ' ') if rule.family else '' }}{{ rule.proto }} dport {{ rule.port }} drop
{% endfor %}
{% if guard_path is not none %}
		# The install's access path: closed after a researcher logged in over the
		# tailnet, with the owner's consent (firewall_close_install_path).
		iifname != "lo" ct state new {{ guard_path.family }} daddr {{ guard_path.address }} tcp dport {{ guard_path.port }} drop
{% endif %}
	}
{% endif %}
}

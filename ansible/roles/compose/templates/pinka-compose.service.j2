# Managed by pinka (ansible/roles/compose/templates/pinka-compose.service.j2). Local changes will be overwritten.
#
# Compose project pinka-{{ compose_project }}:
# oneshot with RemainAfterExit, `up --wait` to start and `down` to stop.
[Unit]
Description=pinka {{ compose_project }} services ({{ compose_description }})
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
PartOf=pinka-lab.target

[Service]
Slice={{ pinka_services_slice }}
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ compose_root }}/{{ compose_project }}
ExecStart=/usr/bin/docker compose up --detach --wait --wait-timeout {{ compose_wait_timeout }} --remove-orphans
ExecReload=/usr/bin/docker compose up --detach --wait --wait-timeout {{ compose_wait_timeout }} --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec={{ compose_wait_timeout + 60 }}

[Install]
WantedBy=pinka-lab.target

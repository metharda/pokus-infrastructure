# Managed by pinka (ansible/roles/compose/templates/env.j2). Local changes will be overwritten.
# Environment of the Compose project {{ compose_project }}: images pinned by
# digest (versions.lock.yml), ports (contracts.md#ports and the lab-internal
# ones), paths and the hashes of the configuration directories under config/.
COMPOSE_PROJECT_NAME=pinka-{{ compose_project }}
PINKA_ROOT={{ pinka_root }}
PINKA_SERVICES={{ compose_root }}/{{ compose_project }}
PINKA_GID={{ compose_pinka_gid }}
POSTGRES_SOCKET_GID={{ compose_db_socket_gid }}
PINKA_QUERY_GID={{ compose_query_gid }}
DOCKER_DATA_ROOT={{ compose_docker['data-root'] | default('/var/lib/docker') }}
COMPOSE_PROFILES={{ (compose_profiles + ([('gpu-' ~ compose_gpu_method)] if compose_gpu and compose_gpu_method != 'none' else [])) | join(',') }}
{% for name, image in compose_images | dictsort %}
{{ name | upper }}_IMAGE={{ image.image }}@{{ image.digest }}
{% endfor %}
{% for name, port in pinka_ports | combine(pinka_internal_ports) | dictsort %}
{{ name | upper }}_PORT={{ port }}
{% endfor %}
{% for key, value in compose_config_hashes | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% for key, value in compose_extra_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}

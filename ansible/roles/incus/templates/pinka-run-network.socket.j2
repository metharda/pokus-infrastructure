# Managed by pinka (ansible/roles/incus/templates/pinka-run-network.socket.j2). Local changes will be overwritten.
#
# Socket of the run-network helper (BUILD_PROMPT §7.7): only the active
# platform's controller account (and root) can connect; every connection
# starts one helper instance, which checks the peer again.
[Unit]
Description=pinka run-network helper socket

[Socket]
ListenStream=/run/pinka/run-network.sock
SocketUser={{ incus_run_network_owner }}
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target

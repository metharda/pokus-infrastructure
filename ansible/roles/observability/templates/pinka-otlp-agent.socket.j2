# Managed by pinka (ansible/roles/observability/templates/pinka-otlp-agent.socket.j2). Local changes will be overwritten.
#
# The agent OTLP socket (BUILD_PROMPT §7.9): untrusted-agent services, which
# have no network, send OTLP/HTTP here (it is bound into their file system);
# pinka-otlp-agent.service forwards it to the collector's receiver
# otlp/agent, whose pipelines stamp everything with pinka.trust=untrusted.
# Sending is all it allows: nothing can be queried through it.
[Unit]
Description=pinka agent OTLP socket (untrusted telemetry)
PartOf=pinka-lab.target

[Socket]
ListenStream={{ observability_agent_socket }}
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=pinka-lab.target

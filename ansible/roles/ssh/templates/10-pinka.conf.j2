{% if ssh_policy_scope == 'group' %}
# Key-only login for researchers (group {{ ssh_allow_groups | join(', ') }}); every other account keeps
# the host's own policy. The block
# ends with this file: sshd restores the including file's Match state.
Match Group {{ ssh_allow_groups | join(',') }}
	PasswordAuthentication no
	KbdInteractiveAuthentication no
	PermitRootLogin no
	PubkeyAuthentication yes
	X11Forwarding no
	# Researchers need local forwards (Grafana, the LLM gateway's ad-hoc endpoint).
	AllowTcpForwarding local
	ClientAliveInterval {{ ssh_client_alive_interval }}
{% else %}
# Key-only login for researchers (group {{ ssh_allow_groups | join(', ') }}); no root login.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
AllowGroups {{ ssh_allow_groups | join(' ') }}
X11Forwarding no
# Researchers need local forwards (Grafana, the LLM gateway's ad-hoc endpoint).
AllowTcpForwarding local
ClientAliveInterval {{ ssh_client_alive_interval }}
{% endif %}

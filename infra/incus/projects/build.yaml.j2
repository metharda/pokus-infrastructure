# Managed by pokus-infra (incus/projects/build.yaml.j2). Local changes will be overwritten.
#
# Golden image builds (BUILD_PROMPT §7.13), with internet access through the
# NAT bridge pokus-build0 only. Only the orchestrator's certificate may use it.
name: build
description: Pokus golden image builds
config:
  features.images: "false"
  features.networks: "false"
  features.profiles: "true"
  features.storage.volumes: "true"
  restricted: "true"
  restricted.containers.nesting: allow
  restricted.networks.access: "{{ incus_build_network }}"
  limits.virtual-machines: "{{ incus_max_virtual_machines if pokus_features.vm_targets else 0 }}"

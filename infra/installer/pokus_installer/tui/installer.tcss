/* The installer's look (BUILD_PROMPT §18.10). Colours come from the theme
   variables only, so the dark, light and high-contrast themes and NO_COLOR
   all work; nothing here assumes more than 80x24. */

Screen {
    layout: vertical;
}

#step-header {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#app-title {
    width: 1fr;
    text-style: bold;
}

#step {
    width: auto;
}

#body {
    height: 1fr;
    padding: 0 1;
}

#nav {
    height: 3;
    padding: 0 1;
    background: $panel;
}

#nav Button {
    margin: 0 1 0 0;
    min-width: 8;
}

#nav .spacer {
    width: 1fr;
}

.field {
    height: auto;
    margin: 0 0 1 0;
}

.field-label {
    text-style: bold;
}

.field.invalid Input,
.field.invalid Select {
    border: tall $error;
}

.hint {
    color: $text-muted;
}

.error {
    color: $error;
    height: auto;
}

.info {
    margin: 0 0 1 0;
}

.greyed {
    color: $text-disabled;
    text-style: italic;
    padding: 1 0;
}

.banner {
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
    border-left: thick $primary;
}

.banner.ok {
    border-left: thick $success;
}

.banner.warn {
    border-left: thick $warning;
    color: $warning;
}

.banner.bad {
    border-left: thick $error;
    color: $error;
    text-style: bold;
}

.card {
    border: round $primary;
    padding: 0 1;
    height: auto;
}

#cards {
    grid-size: 2;
    grid-gutter: 0 1;
    height: auto;
}

.inline {
    height: auto;
}

.inline > * {
    width: 1fr;
    margin: 0 1 0 0;
}

.code {
    height: auto;
}

.bar {
    height: auto;
}

.review-row {
    height: auto;
}

.review-row .card {
    width: 1fr;
}

.review-row .edit {
    width: 8;
    min-width: 8;
}

DataTable {
    height: auto;
    max-height: 12;
}

#progress-main {
    height: auto;
}

#phases {
    width: 1fr;
    max-height: 100%;
}

#side {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
}

#output {
    height: 12;
}

/* Dialogs */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

#dialog {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: thick $primary;
    background: $surface;
    padding: 0 1;
}

#dialog.danger,
.danger #dialog {
    border: thick $error;
}

.dialog-title {
    text-style: bold;
    width: 100%;
    margin: 0 0 1 0;
}

.danger .dialog-title {
    color: $error;
}

.buttons {
    height: 3;
    align-horizontal: right;
}

.buttons Button {
    margin: 0 0 0 1;
}

.text-view {
    height: auto;
    max-height: 16;
}

#secret {
    text-style: bold;
    background: $panel;
    padding: 0 1;
    margin: 1 0;
}

#pair-log {
    height: 8;
}

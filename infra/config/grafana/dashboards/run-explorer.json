{
  "uid": "pokus-run-explorer",
  "title": "Pokus: run explorer",
  "description": "Managed by pokus-infra (config/grafana/dashboards/run-explorer.json). Local changes will be overwritten. Everything recorded for one run: its database rows (once the platform's tables exist), logs, target metrics and traces, filtered by pokus.run_id.",
  "tags": [
    "pokus"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "run_id",
        "label": "Run ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "trace_id",
        "label": "Trace ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "table",
      "title": "Run record (platform database)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT * FROM public.runs WHERE run_id = '${run_id}' LIMIT 1"
        }
      ],
      "id": 1
    },
    {
      "type": "logs",
      "title": "Logs of the run",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} | pokus_run_id=\"${run_id}\""
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Target CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pokus_node) (rate(system_cpu_time_seconds_total{pokus_run_id=\"${run_id}\",state!=\"idle\"}[2m]))",
          "legendFormat": "{{pokus_node}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Target memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pokus_node) (system_memory_usage_bytes{pokus_run_id=\"${run_id}\",state=\"used\"})",
          "legendFormat": "{{pokus_node}}"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Traces of the run",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 50,
          "query": "{ resource.pokus.run_id = \"${run_id}\" }"
        }
      ],
      "id": 5
    },
    {
      "type": "traces",
      "title": "Trace",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "${trace_id}"
        }
      ],
      "id": 6
    }
  ]
}

# Managed by pokus-infra (config/otel/journald.yaml.j2). Local changes will be overwritten.
#
# Journald collector: reads the host journal with the host's journalctl
# (chroot into the read-only host root) and forwards it to the gateway's OTLP
# receiver. It is a separate instance so that the collector that accepts OTLP
# from targets has no access to the host's files; this one listens on nothing
# but its health check and its own metrics on 127.0.0.1.
extensions:
  health_check:
    endpoint: 127.0.0.1:{{ pokus_internal_ports.journald_health }}
  file_storage/journald:
    directory: /var/lib/otelcol/journald

receivers:
  journald:
    root_path: /hostfs
    journalctl_path: /usr/bin/journalctl
    directory: /var/log/journal
    start_at: end
    priority: info
    convert_to_semantic_conventions: true
    storage: file_storage/journald

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: {{ (observability_collector_memory_mib // 2) | int }}
    spike_limit_mib: {{ (observability_collector_memory_mib // 8) | int }}
  resource:
    attributes:
      - key: service.name
        value: journald
        action: insert
  batch: {}

exporters:
  otlp/gateway:
    endpoint: 127.0.0.1:{{ pokus_ports.otlp_grpc }}
    tls:
      insecure: true

service:
  extensions: [health_check, file_storage/journald]
  telemetry:
    metrics:
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: {{ pokus_internal_ports.journald_telemetry }}
  pipelines:
    logs:
      receivers: [journald]
      processors: [memory_limiter, resource, batch]
      exporters: [otlp/gateway]

-- Managed by pokus-infra (config/postgres/bootstrap.sql.j2). Local changes will be overwritten.
--
-- Idempotent database bootstrap (BUILD_PROMPT §7.8, contracts.md#postgresql):
-- roles, the database owner, the schemas public and gt, and the revokes on gt.
-- Table grants come from the platform's migrations. Every change raises a
-- NOTICE that starts with "pokus-changed:", which the role reports as a change.
\set ON_ERROR_STOP on

DO $bootstrap$
DECLARE
  r text;
BEGIN
  FOREACH r IN ARRAY ARRAY[{{ postgres_all_roles | map('regex_replace', '^(.*)$', "'\\1'") | join(', ') }}] LOOP
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = r) THEN
      EXECUTE format('CREATE ROLE %I LOGIN', r);
      RAISE NOTICE 'pokus-changed: created role %', r;
    END IF;
  END LOOP;

  IF (SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = 'pokus') <> 'pokus_migrator' THEN
    ALTER DATABASE pokus OWNER TO pokus_migrator;
    RAISE NOTICE 'pokus-changed: database owner';
  END IF;

  IF (SELECT pg_get_userbyid(nspowner) FROM pg_namespace WHERE nspname = 'public') <> 'pokus_migrator' THEN
    ALTER SCHEMA public OWNER TO pokus_migrator;
    RAISE NOTICE 'pokus-changed: owner of schema public';
  END IF;

  IF NOT EXISTS (SELECT FROM pg_namespace WHERE nspname = 'gt') THEN
    CREATE SCHEMA gt AUTHORIZATION pokus_migrator;
    RAISE NOTICE 'pokus-changed: created schema gt';
  END IF;

  -- Nobody but the platform's ground-truth roles may use gt; the reader and
  -- Grafana roles can never see it (resolution E13).
  IF EXISTS (
    SELECT FROM pg_namespace n, aclexplode(n.nspacl) a
    WHERE n.nspname = 'gt'
      AND (a.grantee = 0 OR pg_get_userbyid(a.grantee) IN ('pokus_reader', 'pokus_grafana'))
  ) THEN
    REVOKE ALL ON SCHEMA gt FROM PUBLIC, pokus_reader, pokus_grafana;
    RAISE NOTICE 'pokus-changed: revoked gt';
  END IF;

  IF has_database_privilege('public', 'pokus', 'CONNECT') THEN
    REVOKE ALL ON DATABASE pokus FROM PUBLIC;
    RAISE NOTICE 'pokus-changed: revoked database from PUBLIC';
  END IF;

  FOREACH r IN ARRAY ARRAY[{{ postgres_all_roles | map('regex_replace', '^(.*)$', "'\\1'") | join(', ') }}] LOOP
    IF NOT has_database_privilege(r, 'pokus', 'CONNECT') THEN
      EXECUTE format('GRANT CONNECT ON DATABASE pokus TO %I', r);
      RAISE NOTICE 'pokus-changed: connect for %', r;
    END IF;
  END LOOP;

  IF NOT pg_has_role('{{ postgres_monitor_role }}', 'pg_monitor', 'MEMBER') THEN
    GRANT pg_monitor TO {{ postgres_monitor_role }};
    RAISE NOTICE 'pokus-changed: pg_monitor for {{ postgres_monitor_role }}';
  END IF;
END
$bootstrap$;

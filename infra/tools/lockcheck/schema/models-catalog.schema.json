{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pokus/schema/models-catalog.schema.json",
  "title": "models.catalog.yml",
  "description": "Curated candidate models per serving profile (BUILD_PROMPT §7.12); entries stay proposed until the owner approves them (owner answer E7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "models", "restricted"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["proposed", "approved"]},
    "models": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "restricted": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "todo": {"type": "string", "pattern": "^TODO\\(verify\\)"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "hf_repo", "revision", "license", "gated", "quantization", "tool_call_parser", "profiles", "chat_template_notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
        "status": {"enum": ["proposed", "approved"]},
        "hf_repo": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "revision": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"$ref": "#/$defs/todo"}]},
        "license": {"type": "string", "minLength": 1},
        "gated": {"type": "boolean"},
        "quantization": {"type": ["string", "null"]},
        "tool_call_parser": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected_vram_gib", "max_model_len"],
            "properties": {
              "expected_vram_gib": {"type": "number", "exclusiveMinimum": 0},
              "max_model_len": {"type": "integer", "minimum": 512}
            }
          }
        },
        "chat_template_notes": {"type": "string", "minLength": 1}
      }
    }
  }
}

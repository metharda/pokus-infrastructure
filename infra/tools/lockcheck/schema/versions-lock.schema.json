{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pinka versions lock",
  "description": "versions.lock.yml (pokus-infrastructure BUILD_PROMPT \u00a710.1, \u00a719.4). Every pinned value is either verified (and matches its pattern) or the marker TODO(verify), which `make lock-check` reports as a failure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_on",
    "fedora_supported_releases",
    "binaries",
    "python",
    "containers",
    "repository_keys",
    "packages",
    "ansible_collections",
    "incus_base_images",
    "github_ssh_host_keys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verified_on": {
      "$ref": "#/$defs/date"
    },
    "fedora_supported_releases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releases",
        "verified_on",
        "source"
      ],
      "properties": {
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "binaries": {
      "type": "object",
      "required": [
        "uv",
        "restic",
        "quarto"
      ],
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/binary"
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "python_build",
        "packages",
        "model_tools",
        "installer",
        "verified_on",
        "source"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "pattern": "^3\\.[0-9]+\\.[0-9]+$"
        },
        "python_build": {
          "$ref": "#/$defs/text"
        },
        "packages": {
          "type": "object",
          "required": [
            "ansible-core"
          ],
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "model_tools": {
          "type": "object",
          "required": [
            "huggingface-hub"
          ],
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "installer": {
          "type": "object",
          "required": [
            "textual",
            "ruamel.yaml",
            "jsonschema"
          ],
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "containers": {
      "$ref": "#/$defs/section",
      "required": [
        "images"
      ],
      "properties": {
        "images": {
          "type": "object",
          "required": [
            "postgres",
            "otel_collector",
            "prometheus",
            "loki",
            "tempo",
            "grafana",
            "node_exporter",
            "cadvisor",
            "postgres_exporter",
            "gpu_exporter",
            "dcgm_exporter",
            "opa",
            "vllm",
            "cuda_base_test"
          ],
          "properties": {
            "vllm": {
              "$ref": "#/$defs/image",
              "required": [
                "cuda"
              ]
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/image"
          }
        },
        "target_images": {
          "type": "object",
          "description": "Images preloaded inside golden images (BUILD_PROMPT \u00a77.13), never run by the lab itself.",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/image"
          }
        },
        "ci_images": {
          "type": "object",
          "description": "Base images of the CI fast lane's systemd containers (BUILD_PROMPT \u00a719.9), never run on a lab host.",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/image"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "repository_keys": {
      "$ref": "#/$defs/section",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "urls",
              "fingerprint"
            ],
            "properties": {
              "urls": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/https_url"
                    },
                    {
                      "$ref": "#/$defs/todo"
                    }
                  ]
                }
              },
              "fingerprint": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^([0-9A-F]{40}|[0-9A-F]{64})$"
                  },
                  {
                    "$ref": "#/$defs/todo"
                  }
                ]
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "packages": {
      "$ref": "#/$defs/section",
      "required": [
        "docker",
        "nvidia_container_toolkit",
        "incus",
        "tailscale"
      ],
      "properties": {
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/release"
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9.+-]*$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/package_version"
                  },
                  {
                    "$ref": "#/$defs/todo"
                  }
                ]
              }
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        }
      }
    },
    "ansible_collections": {
      "$ref": "#/$defs/section",
      "required": [
        "collections"
      ],
      "properties": {
        "collections": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "fallback": {
          "description": "Per collection: its pinned GitHub release tarball and that tarball's sha256, installed by make setup only when Galaxy is unreachable.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "sha256"
            ],
            "properties": {
              "url": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/https_url"
                  },
                  {
                    "$ref": "#/$defs/todo"
                  }
                ]
              },
              "sha256": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "$ref": "#/$defs/todo"
                  }
                ]
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "incus_base_images": {
      "$ref": "#/$defs/section",
      "required": [
        "images"
      ],
      "properties": {
        "images": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "remote",
              "alias",
              "type",
              "fingerprints"
            ],
            "properties": {
              "remote": {
                "type": "string",
                "minLength": 1
              },
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "container",
                  "virtual-machine"
                ]
              },
              "fingerprints": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "$ref": "#/$defs/arch"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "$ref": "#/$defs/todo"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "github_ssh_host_keys": {
      "$ref": "#/$defs/section",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "ssh-ed25519",
              "ecdsa-sha2-nistp256",
              "ssh-rsa"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "public_key",
              "fingerprint"
            ],
            "properties": {
              "public_key": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^AAAA[0-9A-Za-z+/]+=*$"
                  },
                  {
                    "$ref": "#/$defs/todo"
                  }
                ]
              },
              "fingerprint": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^SHA256:[0-9A-Za-z+/]{43}$"
                  },
                  {
                    "$ref": "#/$defs/todo"
                  }
                ]
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "todo": {
      "const": "TODO(verify)"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "arch": {
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)+$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^([0-9]+:)?[0-9][A-Za-z0-9.+~_-]*$"
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release": {
      "type": "string",
      "pattern": "^(ubuntu|debian|fedora|el|opensuse-leap|sles)-[0-9]+(\\.[0-9]+)?$"
    },
    "section": {
      "type": "object",
      "required": [
        "verified_on",
        "source"
      ],
      "properties": {
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "verified_on",
        "source",
        "format",
        "assets"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "format": {
          "enum": [
            "tar.gz",
            "bzip2",
            "binary",
            "deb"
          ]
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x86_64",
            "aarch64"
          ],
          "patternProperties": {
            "^(x86_64|aarch64)$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "sha256"
              ],
              "properties": {
                "url": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/https_url"
                    },
                    {
                      "$ref": "#/$defs/todo"
                    }
                  ]
                },
                "sha256": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/sha256"
                    },
                    {
                      "$ref": "#/$defs/todo"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "tag",
        "digest",
        "platforms"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z]+/[a-z0-9._/-]+$"
        },
        "tag": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
              "not": {
                "enum": [
                  "latest",
                  "main",
                  "master",
                  "nightly",
                  "edge"
                ]
              }
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "linux/amd64"
          },
          "items": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          }
        },
        "cuda": {
          "description": "The CUDA version the image is built on (its CUDA_VERSION); preflight and doctor compare it with the driver (BUILD_PROMPT \u00a72.2).",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        }
      }
    }
  }
}

      "remediation": "The kernel must provide overlay, br_netfilter, nf_tables and veth (built in or loadable)."
    },
    {
      "id": "no_blocking_conflicts",
      "remediation": "Resolve every blocking conflict listed above."
    }
  ],
  "storage": {
    "backends": [
      {
        "feature": "btrfs_pool",
        "backend": "btrfs"
      },
      {
        "feature": "lvm_thin_pool",
        "backend": "lvm"
      }
    ],
    "none_reason": "No quota-capable storage: neither btrfs nor LVM thin provisioning (dm_thin_pool) is available. A `dir` storage backend cannot enforce disk quotas, so disk-exhaustion scenarios would fill the host disk."
  },
  "features": {
    "gpu_inference": {
      "requires": [
        "nvidia_gpu_usable",
        {
          "gpu_vram_gib_min": 8
        },
        {
          "gpu_compute_capability_min": "7.0"
        }
      ],
      "on_missing": "degrade",
      "impact": "No usable GPU: vLLM will not be installed; inference campaigns cannot run on this host."
    },
    "vm_targets": {
      "requires": [
        "kvm_usable"
      ],
      "on_missing": "degrade",
      "impact": "No KVM: VM-class scenarios (kernel-level faults) cannot run on this host."
    },
    "btrfs_pool": {
      "requires": [
        "btrfs_available"
      ],
      "on_missing": "fallback",
      "fallback": "lvm_thin_pool",
      "impact": "No btrfs: the Incus pool falls back to LVM thin provisioning."
    },
    "lvm_thin_pool": {
      "requires": [
        "dm_thin_pool_available"
      ],
      "on_missing": "degrade",
      "only_if_missing": "btrfs_pool",
      "impact": "No LVM thin provisioning."
    },
    "dcgm_metrics": {
      "requires": [
        {
          "environment_in": [
            "baremetal",
            "vm"
          ]
        },
        "nvidia_driver_loaded"
      ],
      "on_missing": "fallback",
      "impact": "No DCGM: GPU metrics come from the nvidia-smi exporter."
    }
  },
  "provider_rules": {
    "wsl2": {
      "needs_action": [
        {
          "id": "wsl_enable_systemd",
          "when": {
            "wsl_conf_systemd": false
          },
          "resolves": [
            "systemd_pid1"
          ],
          "action": "Enable systemd in /etc/wsl.conf (the bootstrap can write it), then run 'wsl --terminate <distro>' from Windows and re-run bootstrap"
        }
      ],
      "warnings": [
        {
          "when": {
            "wsl_interop_enabled": true
          },
          "message": "Windows interop is enabled; the wsl2 provider will disable it"
        },
        {
          "when": {
            "wsl_automount_enabled": true
          },
          "message": "Windows drive automount is enabled; the wsl2 provider will disable it"
        }
      ]
    },
    "baremetal": {
      "needs_action": [
        {
          "id": "secure_boot_mok",
          "when": {
            "secure_boot": "enabled",
            "nvidia_driver_installed": false,
            "nvidia_gpu_present": true,
            "nvidia_driver_mode_in": [
              "auto",
              "manual"
            ]
          },
          "action": "Secure Boot is on: the NVIDIA DKMS module must be signed and a MOK enrolled at next boot. With install_nvidia_driver: auto, consent with --accept-mok-enrollment (or in the installer) and bootstrap installs the driver and imports the MOK; otherwise install the driver yourself. See docs/providers/baremetal.md",
          "planned_when": {
            "nvidia_driver_mode": "auto",
            "mok_enrollment_accepted": true
          },
          "planned": "Secure Boot is on: bootstrap installs the NVIDIA driver, imports a Machine Owner Key with your one-time password and stops with 76; reboot, enroll the key at the blue MOK Manager screen, then re-run bootstrap"
        }
      ]
    },
    "vm": {
      "warnings": [
        {
          "when": {
            "hypervisor_in": [
              "microsoft",
              "vmware",
              "oracle"
            ],
            "kvm_usable": false
          },
          "message": "Nested virtualization unavailable in this hypervisor; VM-class targets disabled"
        }
      ]
    }
  }

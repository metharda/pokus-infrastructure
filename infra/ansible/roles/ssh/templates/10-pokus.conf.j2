# Managed by pokus-infra (ansible/roles/ssh/templates/10-pokus.conf.j2). Local changes will be overwritten.
#
# Key-only login for researchers (group {{ ssh_allow_groups | join(', ') }}); no root login.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
AllowGroups {{ ssh_allow_groups | join(' ') }}
X11Forwarding no
# Researchers need local forwards (Grafana, the LLM gateway's ad-hoc endpoint).
AllowTcpForwarding local
ClientAliveInterval {{ ssh_client_alive_interval }}

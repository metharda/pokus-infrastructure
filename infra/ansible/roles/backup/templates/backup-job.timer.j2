# Managed by pokus-infra (ansible/roles/backup/templates/backup-job.timer.j2). Local changes will be overwritten.
#
# The host is not always on: Persistent=true runs a missed job after boot.
[Unit]
Description=Pokus {{ backup_job.description }} (timer)

[Timer]
OnCalendar={{ backup_job.schedule }}
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target

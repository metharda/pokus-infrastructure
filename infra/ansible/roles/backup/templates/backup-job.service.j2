# Managed by pokus-infra (ansible/roles/backup/templates/backup-job.service.j2). Local changes will be overwritten.
#
# {{ item.description }} (BUILD_PROMPT §7.15), started by {{ item.name }}.timer.
[Unit]
Description=Pokus {{ item.description }}
After={{ item.after }}
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ backup_helper }} --config {{ backup_config_dir }}/backup.json {{ item.command }}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes

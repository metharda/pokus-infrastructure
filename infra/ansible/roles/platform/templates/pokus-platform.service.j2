# Managed by pokus-infra (ansible/roles/platform/templates/pokus-platform.service.j2). Local changes will be overwritten.
#
# {{ platform_unit.description }} (contracts.md, "Accounts, groups and services";
# hardening baseline of BUILD_PROMPT §7.14). Starts only after the health gate.
[Unit]
Description={{ platform_unit.description }}
Requires=pokus-health-gate.service{% for unit in platform_unit.requires | default([]) %} {{ unit }}{% endfor %}

After=pokus-health-gate.service pokus-core.service{% for unit in platform_unit.requires | default([]) + platform_unit.after | default([]) %} {{ unit }}{% endfor %}

{% if platform_unit.before | default([]) %}
Before={{ platform_unit.before | join(' ') }}
{% endif %}
PartOf=pokus-lab.target{% for unit in platform_unit.part_of | default([]) %} {{ unit }}{% endfor %}


[Service]
{% if platform_unit.type | default('simple') == 'oneshot' %}
Type=oneshot
{% else %}
Type=simple
Restart=on-failure
RestartSec=5
{% endif %}
ExecStart={{ platform_current }}/.venv/bin/{{ platform_unit.script }}
{% for spec in platform_unit.sockets | pokus_socket_specs(platform_socket_acls) %}
ExecStartPost=+{{ platform_libexec }}/socket-perms --path {{ spec.path }} --owner {{ spec.owner }} --group {{ spec.group }} --mode {{ spec.mode }}{% for entry in spec.acl %} --acl {{ entry }}{% endfor %}

{% endfor %}
User={{ platform_unit.account }}
Group={{ platform_unit.account }}
SupplementaryGroups={{ platform_unit.groups | join(' ') }}
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute={{ 'yes' if platform_unit.memory_deny_write_execute | default(true) else 'no' }}
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
{% if platform_unit.runtime_dir | default(true) %}
RuntimeDirectory=pokus/{{ platform_unit.svc }}
RuntimeDirectoryMode=0755
{% endif %}
StateDirectory=pokus/{{ platform_unit.svc }}
Environment=HOME=/var/lib/pokus/{{ platform_unit.svc }}
Environment=XDG_CACHE_HOME=/var/lib/pokus/{{ platform_unit.svc }}/cache
{% if platform_unit.read_write %}
ReadWritePaths={{ platform_unit.read_write | join(' ') }}
{% endif %}
InaccessiblePaths={{ (platform_denied_paths + (platform_agent_denied_paths if platform_unit.agent | default(false) else [])) | map('regex_replace', '^', '-') | join(' ') }}

[Install]
WantedBy=pokus-lab.target

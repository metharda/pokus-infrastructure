// Managed by pokus-infra (ansible/roles/base/templates/52pokus-unattended-upgrades.j2). Local changes will be overwritten.
//
// Security updates only, never an automatic reboot; packages that Pokus pins
// (and the kernel on bare metal, unless allow_kernel_updates) are excluded.
Unattended-Upgrade::Origins-Pattern {
{% if pokus_source_group == 'ubuntu' %}
        "origin=Ubuntu,archive=${distro_codename}-security,label=Ubuntu";
{% else %}
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
{% endif %}
};
Unattended-Upgrade::Package-Blacklist {
{% for pattern in base_held_package_patterns + (base_kernel_package_patterns if base_hold_kernel else []) %}
        "{{ pattern }}";
{% endfor %}
};
Unattended-Upgrade::Automatic-Reboot "false";

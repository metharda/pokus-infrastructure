# Managed by pokus-infra (ansible/roles/base/templates/dnf-automatic.conf.j2). Local changes will be overwritten.
#
# Security updates only, never an automatic reboot; pinned packages are held
# with dnf versionlock, the kernel is excluded on bare metal unless
# allow_kernel_updates.
[commands]
upgrade_type = security
download_updates = yes
apply_updates = yes
reboot = never

[emitters]
emit_via = stdio

[base]
{% if base_hold_kernel %}
exclude = {{ base_kernel_package_patterns_rpm | join(' ') }}
{% endif %}

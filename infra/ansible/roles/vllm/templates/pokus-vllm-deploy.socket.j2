# Managed by pokus-infra (ansible/roles/vllm/templates/pokus-vllm-deploy.socket.j2). Local changes will be overwritten.
#
# Socket of the vLLM deploy helper (contracts.md#inference and #sockets, C3):
# only pokus-orch can connect; every connection starts one helper instance.
[Unit]
Description=Pokus vLLM deploy helper socket

[Socket]
ListenStream=/run/pokus/vllm-deploy.sock
SocketUser=pokus-orch
SocketGroup=pokus-orch
SocketMode=0600
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target

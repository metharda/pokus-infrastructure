# Managed by pinka (ansible/roles/vllm/templates/pinka-vllm-deploy@.service.j2). Local changes will be overwritten.
#
# One vLLM deploy helper per connection (contracts.md#inference, C3). Runs as
# root because it rewrites /etc/pinka/vllm and restarts
# pinka-inference.service; it checks the peer itself.
[Unit]
Description=pinka vLLM deploy helper
CollectMode=inactive-or-failed

[Service]
Slice={{ pinka_services_slice }}
Type=oneshot
ExecStart=/usr/local/libexec/pinka/vllm-deploy serve --peer {{ vllm_deploy_peer }}
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths=/etc/pinka/vllm
ReadOnlyPaths={{ pinka_root }}/models

# Managed by pokus-infra (ansible/roles/lab_session/templates/pokus-health-gate.service.j2). Local changes will be overwritten.
#
# Startup gate (BUILD_PROMPT §7.16, contracts.md): the platform's services
# require this unit, so they start only after every check of
# {{ lab_session_gate_config }} passed. Result: {{ lab_session_gate_status }}.
[Unit]
Description=Pokus lab health gate
After=docker.service incus.service incus.socket time-sync.target network-online.target
After=pokus-core.service pokus-observability.service
Wants=network-online.target
PartOf=pokus-lab.target

[Service]
Slice={{ pokus_services_slice }}
Type=oneshot
RemainAfterExit=yes
ExecStart={{ lab_session_libexec }}/health-gate --config {{ lab_session_gate_config }} --status {{ lab_session_gate_status }}
TimeoutStartSec={{ lab_session_gate_timeout | int + 180 }}
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=pokus-lab.target

# Managed by pokus-infra (ansible/roles/firewall/templates/pokus-nftables.service.j2). Local changes will be overwritten.
[Unit]
Description=Pokus firewall policy (nftables table inet pokus_filter)
Wants=network-pre.target
Before=network-pre.target
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/pokus/nftables/pokus.nft
ExecReload=/usr/sbin/nft -f /etc/pokus/nftables/pokus.nft
ExecStop=/usr/sbin/nft delete table inet pokus_filter

[Install]
WantedBy=multi-user.target

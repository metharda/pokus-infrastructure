{#- Managed by pokus-infra (ansible/roles/docker/templates/daemon.json.j2). Local changes will be overwritten.
    JSON has no comments and dockerd rejects unknown keys, so the managed
    header is written as an engine label (preflight looks for it). -#}
{%- set base = {
  "labels": ["org.pokus.managed=Managed by pokus-infra (ansible/roles/docker/templates/daemon.json.j2). Local changes will be overwritten."],
  "data-root": docker_data_root,
  "log-driver": "local",
  "log-opts": {"max-size": docker_log_max_size | string, "max-file": docker_log_max_file | string},
  "live-restore": true,
  "default-address-pools": docker_address_pools,
  "cgroup-parent": docker_cgroup_parent,
} -%}
{%- set gpu = {
  "cdi": {"features": {"cdi": true}},
  "runtime": {"runtimes": {"nvidia": {"path": "/usr/bin/nvidia-container-runtime", "args": []}}},
}[docker_gpu_method] | default({}) -%}
{%- set selinux = {"selinux-enabled": true} if pokus_mac == 'selinux' else {} -%}
{{ base | combine(gpu, selinux) | to_nice_json(indent=2) }}

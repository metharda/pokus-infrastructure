# Managed by pokus-infra (ansible/group_vars/all/vault.yml.example). Local changes will be overwritten.
#
# Shape of group_vars/all/vault.yml, the Ansible Vault file with every secret
# (BUILD_PROMPT §8.2). The real file is always encrypted
# (`ansible-vault create group_vars/all/vault.yml`), never committed to the
# public project (.gitignore), and its values never appear in logs: every task
# that handles them uses `no_log: true`. The installer TUI generates the
# passwords by default. Values below are placeholders.
#
# Per-machine identities are NOT secrets in this file; they are generated on
# the host: SSH host keys, the Tailscale node identity, Incus certificates and
# the run-manifest signing key.

vault_postgres_passwords:          # one per database role (contracts.md)
  pokus_migrator: "<generated>"
  pokus_orch: "<generated>"
  pokus_gw: "<generated>"
  pokus_exec: "<generated>"
  pokus_inject: "<generated>"
  pokus_verify: "<generated>"
  pokus_eval: "<generated>"
  pokus_reader: "<generated>"
  pokus_grafana: "<generated>"

vault_grafana_admin_password: "<generated or entered>"
vault_grafana_user_passwords:      # one per researcher with a Grafana account
  researcher1: "<generated>"
  researcher2: "<generated>"
  researcher3: "<generated>"

vault_restic_repository: "sftp:backup@backup.example.com:/srv/restic/pokus-lab"
vault_restic_password: "<generated>"

vault_tailscale_authkey: ""        # optional; empty = interactive login
vault_hf_token: ""                 # optional; only for gated models
vault_git_deploy_key_platform: ""  # optional; empty = generated deploy key or anonymous HTTPS
vault_git_deploy_key_catalog: ""   # optional

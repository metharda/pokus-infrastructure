# Managed by pinka (images/docker-host/files/web-container.service.j2). Local changes will be overwritten.
#
# The containerized web service, from the image preloaded by digest.
[Unit]
Description=Containerized web service
Requires=docker.service
After=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm --force web
ExecStart=/usr/bin/docker run --rm --name web --publish 8080:80 --pull never {{ web_image }}
ExecStop=/usr/bin/docker stop web
Restart=on-failure

[Install]
WantedBy=multi-user.target

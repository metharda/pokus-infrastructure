{
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {"name": "project-words", "path": "./project-words.txt", "addWords": true}
  ],
  "dictionaries": ["project-words", "en_US", "softwareTerms", "python", "bash", "docker", "node", "fullstack", "misc", "companies"],
  "ignorePaths": [
    "node_modules/**",
    ".venv/**",
    "site/**",
    "build/**",
    "docs/BUILD_PROMPT.md",
    "docs/DOCS_SPEC.md",
    "LICENSE",
    "LICENSE-docs",
    "uv.lock",
    "package-lock.json"
  ],
  "ignoreRegExpList": ["/`[^`\\n]+`/g", "/<!--\\s*qa:[^>]*-->/g"]
}

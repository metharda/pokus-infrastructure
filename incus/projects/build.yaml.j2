# Managed by pinka (incus/projects/build.yaml.j2). Local changes will be overwritten.
#
# Golden image builds, with internet access through the
# NAT bridge pinka-build0 only. Only the platform controller's certificate may
# use it.
name: build
description: pinka golden image builds
config:
  features.images: "false"
  features.networks: "false"
  features.profiles: "true"
  features.storage.volumes: "true"
  restricted: "true"
  restricted.containers.nesting: allow
  restricted.networks.access: "{{ incus_build_network }}"
  limits.virtual-machines: "{{ incus_max_virtual_machines if pinka_features.vm_targets else 0 }}"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pinka/schema/models-lock.schema.json",
  "title": "models.lock.yml",
  "description": "Models selected for a lab, pinned to a commit with a sha256 per file (BUILD_PROMPT §7.12, contracts.md#inference). Never contains unverified values. Adapters are not pinned here: only the GPU arbiter registers them (§7.18).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
    "hf_repo": {"type": "string", "pattern": "^(?!adapters/)[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "Hugging Face repository; never adapters/..., the GPU arbiter's area."},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "description": "Bytes, from the Hub's file metadata; the requirements computation sums them (BUILD_PROMPT §2.3)."}
      }
    },
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hf_repo", "revision", "files", "license", "gated", "quantization", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "hf_repo": {"$ref": "#/$defs/hf_repo"},
        "revision": {"$ref": "#/$defs/revision"},
        "files": {"$ref": "#/$defs/files"},
        "license": {"type": "string", "minLength": 1},
        "gated": {"type": "boolean"},
        "quantization": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}

# Managed by pinka (tests/distros/containers/Containerfile). Local changes will be overwritten.
#
# A systemd container of one distribution family for the CI fast lane:
# the base image comes pinned by digest from
# versions.lock.yml (containers.ci_images); prepare.sh adds systemd, Python and
# sudo with the distribution's package manager. Never run on a lab host.
ARG BASE
FROM ${BASE}
COPY prepare.sh /usr/local/sbin/pinka-ci-prepare
RUN sh /usr/local/sbin/pinka-ci-prepare && rm /usr/local/sbin/pinka-ci-prepare
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]

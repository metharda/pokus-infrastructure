# Managed by pinka (.ansible-lint). Local changes will be overwritten.
#
# ansible-lint with the production profile. Offline: the
# pinned collections come from ansible/requirements.yml through bootstrap,
# never from a lint run.
profile: production
offline: true
exclude_paths:
  - .venv/
  - .ansible-collections/
  - node_modules/
  - site/
  - build/
  - .github/
  - docs/
  - preflight/
  - tools/
  - bootstrap/
  - versions.lock.yml
  - mkdocs.yml
  - .pre-commit-config.yaml
  - .markdownlint-cli2.yaml
  - .yamllint.yml

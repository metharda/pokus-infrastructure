# Managed by pinka (.gitignore).

# Development environments and caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
node_modules/
/.ansible-collections/

# Build outputs
/site/
/build/
# An unpacked release package's collections, NOTICE and RELEASE.json; never committed.
/release/

# Real deployment data never belongs in the public project (the privacy
# rule in CONTRIBUTING.md). Keep it in your lab's own private
# fork or configuration repository; the installer adds these files there.
/ansible/inventory/host_vars/*
!/ansible/inventory/host_vars/example-machine.yml
/users/*.pub
/installer-answers/*
!/installer-answers/README.md
/ansible/group_vars/all/vault.yml
*.vault-pass
.vault-pass*

# The maintainer's private notes, such as the exact details of the test
# computers.
/local/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pinka/contract/v2/records/deployed-from.schema.json",
  "title": "DEPLOYED_FROM.json",
  "description": "Provenance of a deployed platform release or content package (contract v2). Written by infra at the root of every deployed release and content package, root-owned and read-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "kind",
    "package",
    "restricted",
    "source",
    "commit",
    "tree",
    "tag",
    "signed_tag",
    "platform",
    "deployed_at"
  ],
  "properties": {
    "record_version": {
      "const": 1,
      "description": "Version of this record format."
    },
    "kind": {
      "enum": [
        "release",
        "content"
      ],
      "description": "The release, or a content package."
    },
    "package": {
      "type": [
        "string",
        "null"
      ],
      "description": "Content package name; null for the release."
    },
    "restricted": {
      "type": "boolean",
      "description": "A restricted content package (deployed only into the restricted area)."
    },
    "source": {
      "type": "object",
      "description": "The source setting the deployment used.",
      "additionalProperties": false,
      "required": [
        "repo",
        "ref",
        "path",
        "tag_prefix"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository URL (SSH, anonymous HTTPS or file://)."
        },
        "ref": {
          "type": "string",
          "description": "The requested tag, branch or full commit."
        },
        "path": {
          "type": "string",
          "description": "Subdirectory in the repository; empty for the root."
        },
        "tag_prefix": {
          "type": "string",
          "description": "Prefix of the source's release tags."
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The deployed commit."
    },
    "tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git tree of the deployed path at that commit."
    },
    "tag": {
      "type": [
        "string",
        "null"
      ],
      "description": "Release tag with the source's prefix that the commit carries, if any."
    },
    "signed_tag": {
      "type": "object",
      "description": "Signature check of the release tag.",
      "additionalProperties": false,
      "required": [
        "required",
        "verified",
        "signer"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "require_signed_tags was set."
        },
        "verified": {
          "type": "boolean",
          "description": "The tag carries a valid signature of an allowed signer."
        },
        "signer": {
          "type": [
            "string",
            "null"
          ],
          "description": "The signer's principal, when verified."
        }
      }
    },
    "platform": {
      "type": "object",
      "description": "The platform release this deployment belongs to.",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "runtime",
        "manifest_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}$",
          "description": "Platform name."
        },
        "version": {
          "type": "string",
          "description": "SemVer of the release."
        },
        "runtime": {
          "enum": [
            "python-uv",
            "static"
          ],
          "description": "Runtime of the release."
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of platform-manifest.yaml."
        }
      }
    },
    "deployed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC time of the deployment."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pinka/contract/v2/records/adapter-lineage.schema.json",
  "title": "adapter LINEAGE.json",
  "description": "Where a registered adapter came from: `/srv/pinka/models/adapters/<name>/<sha256>/LINEAGE.json`, written by the GPU arbiter with MANIFEST.json (BUILD_PROMPT \u00a77.18), root-owned and read-only; the controller imports it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "adapter",
    "base_model",
    "datasets",
    "image",
    "job",
    "hyperparameters",
    "seed",
    "platform",
    "infra",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "record_version": {
      "const": 1,
      "description": "Version of this record format."
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$",
          "description": "Adapter name."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Adapter hash."
        }
      },
      "description": "The adapter."
    },
    "base_model": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "hf_repo",
        "revision",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Model ID in models.lock.yml."
        },
        "hf_repo": {
          "type": "string",
          "description": "Hugging Face repository."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Pinned revision."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "File in the repository."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Verified SHA-256."
              }
            }
          },
          "description": "The base model's files with their verified hashes."
        }
      },
      "description": "The base model, verified against its MANIFEST.json (models.lock.yml's hashes) before the run; null for a job without a base model."
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Hashes of the datasets mounted into the run."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "description": "The job's image reference from the manifest."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Its digest."
        }
      },
      "description": "The job's container image."
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run",
        "spec_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$",
          "description": "Job name in the manifest."
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Run ID."
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Job-spec hash: SHA-256 of the canonical JSON of the submission."
        }
      },
      "description": "The training run."
    },
    "hyperparameters": {
      "type": "object",
      "description": "The submission's hyperparameters."
    },
    "seed": {
      "type": "integer",
      "description": "The submission's seed."
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Platform name."
        },
        "version": {
          "type": "string",
          "description": "SemVer of the active release."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "description": "Commit of the active release (DEPLOYED_FROM.json)."
        }
      },
      "description": "The active platform release."
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "description": "Infra's commit (/etc/pinka/bootstrap-state.json); null if unknown."
        }
      },
      "description": "The infrastructure release."
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC start of the run."
    },
    "ended_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC end of the run."
    }
  }
}

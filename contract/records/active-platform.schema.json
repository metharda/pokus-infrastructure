{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pinka/contract/v2/records/active-platform.schema.json",
  "title": "active.json",
  "description": "The active platform of the lab, /etc/pinka/platform/active.json (contract v2, BUILD_PROMPT \u00a77.14 \"One platform per lab\", \u00a712.10). Written by infra when a deployment is switched on; 0644 root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "name",
    "version",
    "runtime",
    "manifest_sha256",
    "release",
    "content",
    "services",
    "jobs",
    "cli",
    "names",
    "activated_at"
  ],
  "properties": {
    "record_version": {
      "const": 1,
      "description": "Version of this record format."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}$",
      "description": "Platform name."
    },
    "version": {
      "type": "string",
      "description": "SemVer of the active release."
    },
    "runtime": {
      "enum": [
        "python-uv",
        "static"
      ],
      "description": "Runtime of the release."
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the release's manifest."
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commit",
        "tree",
        "tag",
        "target"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Directory name: the tag, or the full commit."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": "string",
          "description": "Path of the deployed directory."
        },
        "restricted": {
          "type": "boolean"
        }
      },
      "description": "The active release."
    },
    "content": {
      "type": "object",
      "description": "The active content packages by name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "commit",
          "tree",
          "tag",
          "target"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Directory name: the tag, or the full commit."
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "string",
            "description": "Path of the deployed directory."
          },
          "restricted": {
            "type": "boolean"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "description": "The platform's services with their profiles.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "profile"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "description": "The platform's training jobs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "cli": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the researchers' CLI, if any."
    },
    "names": {
      "type": "object",
      "description": "Every name the deployment creates, by reserved-name namespace; they count as the platform's own in the host check of its next release.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "activated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC time of the switch."
    }
  }
}
